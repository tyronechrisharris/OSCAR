# Offline profile: serve TLS using local leaf certs produced by the Ephemeral CA.

:80 {
    # Redirect all HTTP to HTTPS
    redir https://{host}{uri} permanent
}

:443 {
    # Replace with filenames produced by your Ephemeral CA.
    # e.g. /certs/fullchain.pem and /certs/privkey.pem
    tls /certs/fullchain.pem /certs/privkey.pem

    reverse_proxy osh:8282 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }

    log {
        output file /data/logs/caddy_offline.access.log
    }
}
