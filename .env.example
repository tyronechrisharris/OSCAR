# OSCAR Node Deployment Environment Variables

# Database Performance Tuning
DB_SHARED_BUFFERS=128MB
DB_EFFECTIVE_CACHE_SIZE=512MB
DB_WORK_MEM=4MB
DB_MAX_WAL_SIZE=1GB
DB_MAX_CONNECTIONS=50
DB_MAINTENANCE_WORK_MEM=64MB

# Container Resource Limits
DB_MEM_LIMIT=1G
BACKEND_MEM_LIMIT=2G

# OSCAR Network Hardening & Tailscale Configuration
# ------------------------------------------------
# Tailscale IP Address (e.g., 100.x.x.x)
# Required to access the Caddy proxy from your Tailscale network.
TAILSCALE_IP=0.0.0.0

# Tailscale Authentication Key
# Provide an ephemeral or reusable auth key from your Tailscale admin console to initialize the sidecar.
TS_AUTHKEY=

# Tailscale MagicDNS Domain (e.g., oscar-server.tailxxxxx.ts.net)
# Required to automatically generate Let's Encrypt certificates via Tailscale.
TAILSCALE_DOMAIN=oscar-server.tailxxxxx.ts.net

# Local Domain Override (Optional)
LOCAL_DOMAIN=localhost
