# OSCAR Node Deployment Environment Variables

# ==============================================================================
# OSCAR Scaling Profiles
# Choose ONE scenario below and uncomment its block. The default is Scenario B.
# ==============================================================================

# ==============================================================================
# Scenario A: "Edge Node" (1 Lane, All-in-One)
# Hardware: Raspberry Pi (4GB-8GB RAM)
# ==============================================================================
# DB_HOST=osh-postgis
# BACKEND_MEM_LIMIT=2G
# DB_MEM_LIMIT=1G
# DB_MAX_CONNECTIONS=50
# DB_SHARED_BUFFERS=128MB
# DB_EFFECTIVE_CACHE_SIZE=512MB
# DB_WORK_MEM=4MB
# DB_MAX_WAL_SIZE=1GB
# DB_MAINTENANCE_WORK_MEM=64MB

# ==============================================================================
# Scenario B: "Tactical Hub" (10 Lanes / 20 Cameras, All-in-One) -> DEFAULT
# Hardware: Powerful Laptop (16GB RAM)
# ==============================================================================
DB_HOST=osh-postgis
BACKEND_MEM_LIMIT=8G
DB_MEM_LIMIT=4G
DB_MAX_CONNECTIONS=100
DB_SHARED_BUFFERS=1GB
DB_EFFECTIVE_CACHE_SIZE=3GB
DB_WORK_MEM=16MB
DB_MAX_WAL_SIZE=4GB
DB_MAINTENANCE_WORK_MEM=64MB

# ==============================================================================
# Scenario C: "Enterprise Central Hub" (50 Lanes / 100 Cameras, Distributed LAN)
# Hardware: Machine 1 (App Server, 16GB), Machine 2 (DB Server, 16GB)
# ==============================================================================
#
# Machine 1 (Application Server) Profile:
# DB_HOST=<IP_ADDRESS_OF_MACHINE_2>
# BACKEND_MEM_LIMIT=14G
#
# Machine 2 (Database Server) Profile:
# DB_MEM_LIMIT=14G
# DB_MAX_CONNECTIONS=200
# DB_SHARED_BUFFERS=4GB
# DB_EFFECTIVE_CACHE_SIZE=10GB
# DB_WORK_MEM=64MB
# DB_MAX_WAL_SIZE=8GB
# DB_MAINTENANCE_WORK_MEM=1GB

# OSCAR Network Hardening & Tailscale Configuration
# ------------------------------------------------

# 1. Choose a unique name for this specific deployment (e.g., oscar-alpha, oscar-beta)
NODE_NAME=oscar-alpha

# 2. Tailscale Authentication Key
# Provide an ephemeral or reusable auth key from your Tailscale admin console to initialize the sidecar.
TS_AUTHKEY=tskey-auth-xxxxx-yyyyy

# 3. Combine your NODE_NAME with your Tailnet suffix (e.g., tail09415d.ts.net)
# Required to automatically generate Let's Encrypt certificates via Tailscale.
TAILSCALE_DOMAIN=oscar-alpha.tail09415d.ts.net

# Tailscale Subnet Router (Optional)
# Expose local network devices (e.g., IP cameras or RPMs) to the Tailnet.
# TS_ROUTES=192.168.1.100/32, 192.168.1.101/32 # Exposes specific cameras
# TS_ROUTES=192.168.1.0/24                     # Exposes the entire local subnet

# Local Domain Override (Optional)
LOCAL_DOMAIN=localhost
