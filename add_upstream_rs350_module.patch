+    @Test
+    public void testGamepadPtzProcess() throws Exception
+    {
+        ProcessHelper processHelper = new ProcessHelper();
+        SWEHelper fac = new SWEHelper();
+
+        OccupancyDataRecorder process = new OccupancyDataRecorder();
