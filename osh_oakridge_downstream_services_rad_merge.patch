diff --git a/include/osh-oakridge-modules/sensors/sensorhub-utils-rad/src/main/java/org/sensorhub/impl/utils/rad/model/OccupancyExtended.java b/include/osh-oakridge-modules/sensors/sensorhub-utils-rad/src/main/java/org/sensorhub/impl/utils/rad/model/OccupancyExtended.java
